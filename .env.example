# Kola Express Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER COMMIT .env OR REAL CREDENTIALS TO GITHUB.

PORT=3000
ADMIN_PORT=3001
JWT_SECRET=replace_with_a_secure_random_jwt_secret_for_production

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (safe for public clients, respects RLS)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Service Role Key (NEVER expose to frontend; backend use only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Direct PostgreSQL Connection String for Supabase Migrations & Sync
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or pooled: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# NOTE: If your password contains special characters like '@', encode it (e.g. '@' -> '%40')
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres

# =============================================================================
# GOOGLE MAPS PLATFORM CONFIGURATION
# =============================================================================
# Server-Side Key (Restricted to server IP, used for Routes API & Geocoding)
# NEVER expose this key to frontend or mobile clients.
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_restricted_key_here

# Client-Side Public Keys (Restricted to HTTP referrers, Android package, iOS bundle)
GOOGLE_MAPS_WEB_KEY=your_google_maps_web_http_referrer_restricted_key_here
GOOGLE_MAPS_ANDROID_KEY=your_google_maps_android_package_restricted_key_here
GOOGLE_MAPS_IOS_KEY=your_google_maps_ios_bundle_restricted_key_here

# =============================================================================
# EMAIL & SMTP CONFIGURATION (Password Recovery & Security Alerts)
# =============================================================================
# For Hostinger Email:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your_email_password
# SMTP_FROM="Kola Express <noreply@yourdomain.com>"
# (If omitted, system safely logs recovery codes to console simulator in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
